+  /// WORKTREE ONLY. Refuses to go on unless mpv itself says it has no audio
+  /// and no video output.
+  Future<void> assertSilent() async {
+    final native = _player!.platform as dynamic;
+    final ao = await native.getProperty('ao') as String;
+    final vo = await native.getProperty('vo') as String;
+    final mute = await native.getProperty('mute') as String;
+    if (ao != 'null' || vo != 'null' || mute != 'yes') {
+      throw StateError('mpv is not silent: ao=$ao vo=$vo mute=$mute');
+    }
+  }
+
+  /// WORKTREE ONLY. The same for what mpv actually opened for a file.
+  Future<String> silenceInUse() async {
+    final native = _player!.platform as dynamic;
+    final currentAo = await native.getProperty('current-ao') as String;
+    final currentVo = await native.getProperty('current-vo') as String;
+    if ((currentAo.isNotEmpty && currentAo != 'null') || (currentVo.isNotEmpty && currentVo != 'null')) {
+      throw StateError('mpv opened real output: ao=$currentAo vo=$currentVo');
+    }
+    return 'current-ao=$currentAo current-vo=$currentVo';
+  }
+
+  /// WORKTREE ONLY. A property read for the measurements.
+  Future<String> headlessProperty(String name) async => await (_player!.platform as dynamic).getProperty(name) as String;
+
+  /// WORKTREE ONLY.
+  Future<void> headlessSet(String name, String value) async =>
+      (_player!.platform as dynamic).setProperty(name, value);
